# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
AUTH_SECRET=replace-with-a-long-random-secret

# Optional but recommended
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Any signed-in account matching this username is auto-bootstrapped to admin
ADMIN_USERNAME=yourusername

# x402 payment gate for /api/* (USDC on Base mainnet). The default facilitator
# only settles testnets; point this at one that supports exact on eip155:8453.
# X402_FACILITATOR_URL=https://x402.org/facilitator
